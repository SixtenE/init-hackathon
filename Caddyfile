{
	# Railway terminates TLS in front of the container.
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode gzip zstd

	handle /ws {
		reverse_proxy 127.0.0.1:8090
	}

	handle /health {
		reverse_proxy 127.0.0.1:8090
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
